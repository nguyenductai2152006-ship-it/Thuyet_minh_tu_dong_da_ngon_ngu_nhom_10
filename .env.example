# HoiAnGuide Sync 1.8 - Environment template
# Create a local .env containing all required passwords and JWT_SECRET.
# Never commit .env or replace credentials of an existing MySQL volume.
# If you copy this to .env, do not uncomment the placeholders below.
# MYSQL_ROOT_PASSWORD=<generate-a-64-hex-character-random-secret>
# IDENTITY_DB_PASSWORD=<generate-a-64-hex-character-random-secret>
# POI_DB_PASSWORD=<generate-a-64-hex-character-random-secret>
# LOCALIZATION_DB_PASSWORD=<generate-a-64-hex-character-random-secret>
# AUDIO_DB_PASSWORD=<generate-a-64-hex-character-random-secret>
# JWT_SECRET=<generate-a-64-hex-character-random-secret>
JWT_EXPIRATION_MS=3600000
FRONTEND_BIND=127.0.0.1
